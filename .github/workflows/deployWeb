name: Deploy Godot Web

on:
  push:
    branches:
      - main

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y fontconfig unzip wget

      - name: Install Godot
        run: |
          wget https://github.com/godotengine/godot/releases/download/4.6.3-stable/Godot_v4.6.3-stable_linux.x86_64.zip
          unzip Godot_v4.6.3-stable_linux.x86_64.zip
          sudo mv Godot_v4.6.3-stable_linux.x86_64 /usr/local/bin/godot
          sudo chmod +x /usr/local/bin/godot

      - name: Install Godot export templates
        run: |
          mkdir -p /tmp/godot-templates

          wget https://github.com/godotengine/godot/releases/download/4.6.3-stable/Godot_v4.6.3-stable_export_templates.tpz \
            -O /tmp/godot-templates/templates.tpz

          unzip -q /tmp/godot-templates/templates.tpz \
            -d /tmp/godot-templates/extracted

          mkdir -p /github/home/.local/share/godot/export_templates/4.6.3.stable

          find /tmp/godot-templates/extracted -type f -name "*.zip" -exec cp {} /github/home/.local/share/godot/export_templates/4.6.3.stable/ \;

          echo "Installed templates:"
          ls -lah /github/home/.local/share/godot/export_templates/4.6.3.stable/

      - name: Verify Godot
        run: |
          godot --version

      - name: Import project
        run: |
          godot --headless --editor --quit

      - name: Export Web
        run: |
          mkdir -p build
          godot --headless --export-release "Web" build/index.html

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: build

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    runs-on: ubuntu-latest
    needs: build

    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4